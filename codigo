<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Gerador de Provas Dissertativas — Colégio Criarte</title>
  <script src="https://cdn.tailwindcss.com/3.4.17"></script>
  <script src="https://unpkg.com/lucide@0.460.0/dist/umd/lucide.min.js"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <style>
    body {
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    }

    /* Folha A4 na prévia */
    .a4-sheet {
      width: 100%;
      max-width: 794px;
      background: #ffffff;
      color: #0f172a;
      box-shadow: 0 10px 30px -5px rgba(15, 23, 42, 0.12), 0 4px 10px -2px rgba(15, 23, 42, 0.06);
      border: 1px solid #e2e8f0;
    }

    /* Caixas arredondadas no padrão oficial do Colégio Criarte */
    .criarte-box {
      border: 1.25px solid #1e293b;
      border-radius: 7px;
      background: #ffffff;
    }

    .criarte-banner {
      border: 1.25px solid #94a3b8;
      border-radius: 9999px;
      background: linear-gradient(180deg, #f8fafc 0%, #e5e7eb 100%);
    }

    .criarte-content-box {
      border: 1.25px solid #1e293b;
      border-radius: 18px;
      background: linear-gradient(180deg, #f3f4f6 0%, #eef2f6 100%);
    }

    .criarte-instructions-box {
      border: 1.25px solid #1e293b;
      border-radius: 26px;
      background: #ffffff;
    }

    .ruled-line {
      height: 28px;
      border-bottom: 1px solid #94a3b8;
      width: 100%;
    }

    @keyframes pulseHighlight {
      0% { box-shadow: 0 0 0 3px rgba(29, 78, 216, 0.35); }
      100% { box-shadow: 0 0 0 0 rgba(29, 78, 216, 0); }
    }

    .header-flash {
      animation: pulseHighlight 0.65s ease-out;
    }

    .page-divider-preview {
      border-top: 2px dashed #cbd5e1;
      margin: 28px 0 22px;
      position: relative;
      text-align: center;
    }

    .page-divider-preview span {
      position: relative;
      top: -10px;
      background: #ffffff;
      padding: 0 10px;
      font-size: 10px;
      font-weight: 700;
      color: #64748b;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    /* Estilos específicos de impressão / PDF */
    @media print {
      @page {
        size: A4 portrait;
        margin: 12mm 14mm;
      }

      body {
        background: #ffffff !important;
        margin: 0 !important;
        padding: 0 !important;
        -webkit-print-color-adjust: exact !important;
        print-color-adjust: exact !important;
      }

      .no-print {
        display: none !important;
      }

      .print-container {
        display: block !important;
        padding: 0 !important;
        margin: 0 !important;
        width: 100% !important;
        max-width: none !important;
      }

      .a4-sheet {
        max-width: none !important;
        min-height: auto !important;
        box-shadow: none !important;
        border: none !important;
        padding: 0 !important;
        margin: 0 !important;
      }

      .print-page-break {
        page-break-before: always;
        break-before: page;
      }

      .page-divider-preview {
        display: none !important;
      }

      .question-block,
      .rubric-block {
        break-inside: avoid;
        page-break-inside: avoid;
      }

      .ruled-line {
        border-bottom: 1px solid #64748b !important;
      }
    }
  </style>
</head>
<body class="bg-slate-100 text-slate-900 min-h-screen flex flex-col">

  <!-- Barra Superior -->
  <header class="no-print sticky top-0 z-30 bg-white border-b border-slate-200 shadow-sm">
    <div class="max-w-[1440px] mx-auto px-4 sm:px-6 py-3 flex flex-wrap items-center justify-between gap-3">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-lg bg-[#0b2a82] text-white flex items-center justify-center shrink-0 relative">
          <i data-lucide="file-check-2" class="w-5 h-5"></i>
          <span class="w-2.5 h-2.5 rounded-full bg-red-600 border-2 border-white absolute -top-0.5 -right-0.5"></span>
        </div>
        <div>
          <h1 class="text-sm sm:text-base font-bold text-slate-900 leading-tight">Gerador de Provas — Colégio Criarte</h1>
          <p class="text-xs text-slate-500 hidden sm:block">Padrão oficial de capa, conteúdo, instruções e questões dissertativas</p>
        </div>
      </div>

      <div class="flex flex-wrap items-center gap-2 sm:gap-3">
        <!-- Contador de Pontos -->
        <div id="scoreBadge" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-semibold border transition-colors">
          <i data-lucide="calculator" class="w-3.5 h-3.5"></i>
          <span id="scoreBadgeText">Total: 10.0 / 10.0 pts</span>
        </div>

        <!-- Alternador Aluno / Gabarito -->
        <div class="inline-flex rounded-lg bg-slate-100 p-1 border border-slate-200" role="group" aria-label="Modo de visualização">
          <button type="button" id="btnModeStudent" class="px-2.5 py-1 text-xs font-semibold rounded-md transition-colors bg-white text-[#0b2a82] shadow-sm">
            Prova do Aluno
          </button>
          <button type="button" id="btnModeKey" class="px-2.5 py-1 text-xs font-semibold rounded-md transition-colors text-slate-600 hover:text-slate-900">
            Gabarito
          </button>
        </div>

        <!-- Botão Imprimir / Salvar PDF -->
        <button type="button" id="btnPrint" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-lg bg-[#0b2a82] hover:bg-[#082066] text-white text-xs sm:text-sm font-semibold shadow-sm transition-colors">
          <i data-lucide="printer" class="w-4 h-4"></i>
          <span>Imprimir / PDF</span>
        </button>
      </div>
    </div>
  </header>

  <!-- Toast de Feedback -->
  <div id="toast" class="no-print fixed bottom-5 right-5 z-50 hidden items-center gap-2 bg-slate-900 text-white text-xs font-medium px-4 py-2.5 rounded-lg shadow-lg">
    <i data-lucide="check-circle-2" class="w-4 h-4 text-emerald-400"></i>
    <span id="toastMessage">Ação concluída</span>
  </div>

  <!-- Conteúdo Principal -->
  <main class="flex-1 max-w-[1440px] w-full mx-auto px-4 sm:px-6 py-5 grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">

    <!-- COLUNA ESQUERDA: FORMULÁRIO GUIADO -->
    <section class="no-print lg:col-span-5 flex flex-col gap-4">

      <!-- Abas de Navegação do Formulário -->
      <div class="bg-white rounded-xl border border-slate-200 p-1.5 flex gap-1 shadow-sm">
        <button type="button" data-tab="header" class="tab-btn flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition-colors bg-blue-50 text-[#0b2a82]">
          <span class="w-5 h-5 rounded-full bg-[#0b2a82] text-white text-[11px] flex items-center justify-center">1</span>
          <span>Cabeçalho</span>
        </button>
        <button type="button" data-tab="questions" class="tab-btn flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition-colors text-slate-600 hover:bg-slate-50">
          <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-700 text-[11px] flex items-center justify-center">2</span>
          <span>Questões (<span id="questionCountTab">2</span>)</span>
        </button>
        <button type="button" data-tab="settings" class="tab-btn flex-1 flex items-center justify-center gap-1.5 py-2 px-3 rounded-lg text-xs sm:text-sm font-semibold transition-colors text-slate-600 hover:bg-slate-50">
          <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-700 text-[11px] flex items-center justify-center">3</span>
          <span>Padrão</span>
        </button>
      </div>

      <!-- ABA 1: CABEÇALHO & CONTEÚDO -->
      <div id="panel-header" class="tab-panel bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-sm space-y-5">
        <div class="flex items-center justify-between border-b border-slate-100 pb-3">
          <div>
            <h2 class="text-sm font-bold text-slate-900">Montagem Automática da Capa Criarte</h2>
            <p class="text-xs text-slate-500">Selecione as opções e acompanhe o cabeçalho se formando ao lado.</p>
          </div>
          <span class="text-[11px] font-semibold text-[#0b2a82] bg-blue-50 px-2 py-0.5 rounded-md">Ao vivo</span>
        </div>

        <!-- Pergunta 1: Segmento -->
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-2">
            1. Qual segmento?
          </label>
          <div id="segmentOptions" class="grid grid-cols-3 gap-2"></div>
        </div>

        <!-- Pergunta 2: Período -->
        <div>
          <label class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-2">
            2. Qual período?
          </label>
          <div id="bimesterOptions" class="grid grid-cols-4 gap-2"></div>
        </div>

        <!-- Pergunta 3: Disciplina -->
        <div>
          <label for="customSubjectInput" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-2">
            3. Qual disciplina?
          </label>
          <div id="subjectChips" class="flex flex-wrap gap-1.5 mb-2"></div>
          <input type="text" id="customSubjectInput" placeholder="Ou digite outra disciplina (ex.: Matemática A/C)..." class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600" />
        </div>

        <!-- Dados da Avaliação -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-slate-100">
          <div>
            <label for="examTypeSelect" class="block text-xs font-semibold text-slate-700 mb-1">Tipo de Avaliação</label>
            <select id="examTypeSelect" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-blue-600">
              <option value="Avaliação de Ciclo 01 - F">Avaliação de Ciclo 01 - F</option>
	      <option value="Avaliação de Ciclo 01 - I">Avaliação de Ciclo 01 - I</option>
              <option value="Avaliação de Ciclo 01 - R">Avaliação de Ciclo 01 - R</option>
              <option value="Avaliação de Ciclo 02 - F">Avaliação de Ciclo 02 - F</option>
	      <option value="Avaliação de Ciclo 02 - I">Avaliação de Ciclo 01 - I</option>
              <option value="Avaliação de Ciclo 02 - R">Avaliação de Ciclo 02 - R</option>
              <option value="Avaliação Substitutiva">Avaliação Substitutiva</option>
              <option value="Recuperação de Período">Recuperação de Período</option>
            </select>
          </div>
          <div>
            <label for="examDateInput" class="block text-xs font-semibold text-slate-700 mb-1">Data da Aplicação</label>
            <input type="date" id="examDateInput" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>
          <div>
            <label for="gradeSelect" class="block text-xs font-semibold text-slate-700 mb-1">Série / Ano</label>
            <select id="gradeSelect" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 bg-white focus:outline-none focus:ring-2 focus:ring-blue-600"></select>
          </div>
          <div>
            <label for="classGroupInput" class="block text-xs font-semibold text-slate-700 mb-1">Turmas no cabeçalho</label>
            <input type="text" id="classGroupInput" placeholder="Ex.: A, B, C" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>
          <div>
            <label for="teacherInput" class="block text-xs font-semibold text-slate-700 mb-1">Professor(a)</label>
            <input type="text" id="teacherInput" placeholder="Nome do(a) docente" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>
          <div>
            <label for="targetScoreInput" class="block text-xs font-semibold text-slate-700 mb-1">Valor Total da Prova</label>
            <input type="number" id="targetScoreInput" step="0.5" min="1" max="100" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600" />
          </div>
        </div>

        <!-- Quadro de Conteúdo -->
        <div class="pt-2 border-t border-slate-100">
          <label for="topicsTextarea" class="block text-xs font-bold text-slate-700 uppercase tracking-wide mb-1">
            4. Conteúdo da Avaliação (um tópico por linha)
          </label>
          <p class="text-[11px] text-slate-500 mb-2">Cada linha aparece automaticamente com marcador ➤ no quadro Conteúdo.</p>
          <textarea id="topicsTextarea" rows="4" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600 leading-relaxed" placeholder="Digite um tópico por linha..."></textarea>
        </div>

        <div class="pt-1 flex justify-end">
          <button type="button" id="btnGoToQuestions" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg bg-slate-900 hover:bg-slate-800 text-white text-xs font-semibold transition-colors">
            <span>Ir para Questões</span>
            <i data-lucide="arrow-right" class="w-3.5 h-3.5"></i>
          </button>
        </div>
      </div>

      <!-- ABA 2: QUESTÕES -->
      <div id="panel-questions" class="tab-panel hidden space-y-3">
        <div class="bg-white rounded-xl border border-slate-200 p-4 shadow-sm flex items-center justify-between gap-2">
          <div>
            <h2 class="text-sm font-bold text-slate-900">Questões Dissertativas</h2>
            <p class="text-xs text-slate-500">Use verbos de comando claros e ajuste as linhas pautadas.</p>
          </div>
          <button type="button" id="btnAddQuestion" class="inline-flex items-center gap-1 px-3 py-2 rounded-lg bg-[#0b2a82] hover:bg-[#082066] text-white text-xs font-semibold shadow-sm shrink-0 transition-colors">
            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
            <span>Nova Questão</span>
          </button>
        </div>

        <!-- Lista dinâmica de questões -->
        <div id="questionsEditorList" class="space-y-3"></div>
      </div>

      <!-- ABA 3: PADRÃO DA ESCOLA -->
      <div id="panel-settings" class="tab-panel hidden bg-white rounded-xl border border-slate-200 p-4 sm:p-5 shadow-sm space-y-4">
        <div class="border-b border-slate-100 pb-3">
          <h2 class="text-sm font-bold text-slate-900">Identidade e Padrão — Colégio Criarte</h2>
          <p class="text-xs text-slate-500">Ajuste a capa institucional, logotipo e blocos opcionais da prova.</p>
        </div>

        <div>
          <label for="schoolNameInput" class="block text-xs font-semibold text-slate-700 mb-1">Nome no Banner Superior</label>
          <input type="text" id="schoolNameInput" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600" />
        </div>

        <div>
          <label for="schoolSubtitleInput" class="block text-xs font-semibold text-slate-700 mb-1">Texto auxiliar (usado no rodapé/página 2)</label>
          <input type="text" id="schoolSubtitleInput" placeholder="Ex.: Coordenação Pedagógica • Ano Letivo 2026" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-600" />
        </div>

        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Logotipos oficiais (Criarte + Cambridge + Anglo)</label>
          <div class="flex items-center gap-2">
            <label for="logoUploadInput" class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-2 rounded-lg border border-slate-200 bg-slate-50 hover:bg-slate-100 text-xs font-semibold text-slate-700 transition-colors">
              <i data-lucide="upload" class="w-3.5 h-3.5"></i>
              <span>Substituir imagem</span>
            </label>
            <input type="file" id="logoUploadInput" accept="image/*" class="hidden" />
            <button type="button" id="btnRemoveLogo" class="hidden text-xs text-rose-600 hover:underline font-medium">Voltar ao logo Criarte</button>
          </div>
        </div>

        <div class="space-y-2.5 pt-2 border-t border-slate-100">
          <label class="flex items-start gap-2.5 cursor-pointer">
            <input type="checkbox" id="toggleInstructions" class="mt-0.5 rounded border-slate-300 text-[#0b2a82] focus:ring-blue-600" />
            <span class="text-xs text-slate-700">
              <strong class="block font-semibold">Exibir quadro oficial de Instruções (9 itens Criarte)</strong>
              Inclui as normas de caneta, desconto gramatical e regras para Exatas na página 1.
            </span>
          </label>

          <label class="flex items-start gap-2.5 cursor-pointer">
            <input type="checkbox" id="togglePageBreak" class="mt-0.5 rounded border-slate-300 text-[#0b2a82] focus:ring-blue-600" />
            <span class="text-xs text-slate-700">
              <strong class="block font-semibold">Separar Capa (Pág. 1) das Questões (Pág. 2+) na impressão</strong>
              Mantém a folha de rosto idêntica ao modelo impresso e inicia a Questão 1 na página seguinte.
            </span>
          </label>

          <label class="flex items-start gap-2.5 cursor-pointer">
            <input type="checkbox" id="toggleRubric" class="mt-0.5 rounded border-slate-300 text-[#0b2a82] focus:ring-blue-600" />
            <span class="text-xs text-slate-700">
              <strong class="block font-semibold">Incluir quadro de Rubrica de Correção</strong>
              Tabela padrão de 4 critérios no final do caderno de questões.
            </span>
          </label>
        </div>

        <!-- Restaurar exemplo -->
        <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
          <span class="text-xs text-slate-500">Deseja restaurar o modelo padrão Criarte?</span>
          <button type="button" id="btnResetDemo" class="px-3 py-1.5 rounded-lg border border-slate-200 hover:bg-slate-50 text-xs font-semibold text-slate-700 transition-colors">
            Restaurar padrão
          </button>
        </div>
      </div>

    </section>

    <!-- COLUNA DIREITA: PRÉVIA AO VIVO EM FOLHA A4 -->
    <section class="print-container lg:col-span-7 flex flex-col items-center">
      <div class="no-print w-full max-w-[794px] flex items-center justify-between mb-2 px-1">
        <span class="text-xs font-semibold text-slate-500 flex items-center gap-1.5">
          <i data-lucide="eye" class="w-3.5 h-3.5 text-[#0b2a82]"></i>
          Prévia em tempo real (padrão Colégio Criarte • A4)
        </span>
        <span id="previewModeLabel" class="text-[11px] font-semibold px-2 py-0.5 rounded bg-blue-100 text-[#0b2a82]">
          Versão do Aluno
        </span>
      </div>

      <!-- FOLHA A4 -->
      <article id="examSheet" class="a4-sheet rounded-lg p-6 sm:p-9 text-slate-900">
        <!-- Renderizado dinamicamente via JS -->
      </article>
    </section>

  </main>

  <script>
    const DEFAULT_CRIARTE_LOGO = "data:image/png;base64,";

    const SEGMENT_DATA = {
