      }
    };

    const PERIODS = ['1º Período', '2º Período', '3º Período'];

    const COMMAND_VERBS = ['Explique', 'Determine', 'Calcule', 'Compare', 'Justifique', 'Analise'];

    const STORAGE_KEY = 'gerador_provas_criarte_v2';

    function getDefaultState() {
      return {
        schoolName: 'COLÉGIO CRIARTE',
        schoolSubtitle: 'Coordenação Pedagógica • Sistema de Ensino Anglo',
        logoDataUrl: '',
        segment: 'ENSINO MÉDIO',
        bimester: '3º Período',
        subject: 'Matemática A/C',
        grade: '3ª Série do EM',
        classGroup: 'A, B, C',
        examType: 'Avaliação de Ciclo 01 - R',
        examDate: '2026-09-23',
        teacher: 'Bruno Tafarello',
        targetScore: 10.0,
        topicsText: 'Seno, Cosseno e Tangente da soma e diferença de arcos;\nFunções Trigonométricas;\nExponenciais;\nLogaritmos;',
        showInstructions: true,
        separateCoverPage: true,
        showRubric: false,
        viewMode: 'student',
        activeTab: 'header',
        questions: [
          {
            id: 'q1',
            context: 'Sabendo que sen(a) = 3/5 e cos(b) = 12/13, com a e b pertencentes ao 1º quadrante do ciclo trigonométrico.',
            prompt: 'Determine o valor exato de sen(a + b) e justifique cada etapa da resolução utilizando a identidade trigonométrica da soma de arcos.',
            points: 5.0,
            lines: 6,
            expectedAnswer: 'Como a e b estão no 1º quadrante, cos(a) = 4/5 e sen(b) = 5/13. Aplicando sen(a + b) = sen(a)·cos(b) + sen(b)·cos(a) = (3/5)·(12/13) + (5/13)·(4/5) = 36/65 + 20/65 = 56/65.'
          },
          {
            id: 'q2',
            context: 'Uma cultura bacteriana dobra sua população a cada 3 horas, segundo o modelo exponencial P(t) = P₀ · 2^(t/3), em que P₀ = 500 bactérias.',
            prompt: 'Calcule após quantas horas a população atingirá 16.000 bactérias, registrando todo o desenvolvimento algébrico.',
            points: 5.0,
            lines: 6,
            expectedAnswer: 'Substituindo P(t) = 16.000: 16.000 = 500 · 2^(t/3) ⇒ 32 = 2^(t/3) ⇒ 2^5 = 2^(t/3) ⇒ t/3 = 5 ⇒ t = 15 horas.'
          }
        ]
      };
    }

    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return getDefaultState();
        const parsed = JSON.parse(raw);
        return { ...getDefaultState(), ...parsed };
      } catch (e) {
        return getDefaultState();
      }
    }

    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      } catch (e) {
        // Ignora erro de quota ou storage bloqueado
      }
    }

    let state = loadState();
    let toastTimer = null;

    function showToast(msg) {
      const toast = document.getElementById('toast');
      const text = document.getElementById('toastMessage');
      text.textContent = msg;
      toast.classList.remove('hidden');
      toast.classList.add('flex');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => {
        toast.classList.add('hidden');
        toast.classList.remove('flex');
      }, 2400);
    }

    function escapeHtml(str) {
      return String(str || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
    }

    function formatPoints(val) {
      const num = Number(val) || 0;
      return num.toFixed(1);
    }

    function formatDateCriarte(isoDate) {
      if (!isoDate) return '____ / ____ / ________';
      const parts = isoDate.split('-');
      if (parts.length !== 3) return isoDate;
      return `${parts[2]} /${parts[1]} /${parts[0]}`;
    }

    function flashHeaderPreview() {
      const headerBox = document.getElementById('previewHeaderBox');
      if (!headerBox) return;
      headerBox.classList.remove('header-flash');
      void headerBox.offsetWidth;
      headerBox.classList.add('header-flash');
    }

    /* ---------- RENDERIZAÇÃO DOS CONTROLES DO FORMULÁRIO ---------- */

    function renderSegmentOptions() {
      const container = document.getElementById('segmentOptions');
      container.innerHTML = Object.entries(SEGMENT_DATA).map(([segKey, info]) => {
        const active = state.segment === segKey;
        return `
          <button type="button" data-segment="${escapeHtml(segKey)}"
            class="segment-btn py-2.5 px-2 rounded-lg border text-xs font-semibold transition-all text-center ${
              active
                ? 'bg-[#0b2a82] text-white border-[#0b2a82] shadow-sm'
                : 'bg-white text-slate-700 border-slate-200 hover:border-blue-400 hover:bg-blue-50/40'
            }">
            <span class="block">${escapeHtml(info.short)}</span>
            <span class="block text-[10px] font-normal ${active ? 'text-blue-100' : 'text-slate-400'}">${escapeHtml(info.label)}</span>
          </button>
        `;
      }).join('');

      container.querySelectorAll('.segment-btn').forEach(btn => {
        btn.addEventListener('click', () => {
