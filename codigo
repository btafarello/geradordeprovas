              ${escapeHtml(state.examType)} • ${escapeHtml(state.bimester)}
              ${isKey ? '<span class="ml-1.5 px-1.5 py-0.5 rounded bg-emerald-600 text-white text-[10px]">GABARITO</span>' : ''}
            </div>
          </div>
      ` : `<div class="mt-6 pt-4 border-t border-slate-300">`;

      sheet.innerHTML = `
        <!-- CABEÇALHO OFICIAL COLÉGIO CRIARTE -->
        <div id="previewHeaderBox" class="rounded-lg transition-shadow">
          <div class="grid grid-cols-12 gap-3 items-start">
            <!-- Coluna dos Logotipos (Esquerda) -->
            <div class="col-span-3 flex items-center justify-center pt-1">
              <img src="${logoSrc}" alt="Logotipos Colégio Criarte, Cambridge e Anglo" class="w-full max-w-[132px] h-auto object-contain" />
            </div>

            <!-- Coluna do Cabeçalho Estruturado (Direita) -->
            <div class="col-span-9 space-y-1.5">
              <!-- Banner Superior Arredondado -->
              <div class="criarte-banner px-4 py-1.5 text-center">
                <div class="text-xs sm:text-sm font-black tracking-wide text-slate-900 uppercase">
                  ${escapeHtml(state.schoolName || 'COLÉGIO CRIARTE')} - ${escapeHtml(state.segment)}
                </div>
              </div>

              ${isKey ? `
                <div class="text-center">
                  <span class="inline-block px-3 py-0.5 rounded-full bg-emerald-600 text-white text-[10px] font-bold uppercase tracking-wider">
                    Versão do Professor — Gabarito Oficial
                  </span>
                </div>
              ` : ''}

              <!-- Linha 1: Tipo de Avaliação | Data | Período -->
              <div class="grid grid-cols-12 gap-1.5 text-[11px]">
                <div class="criarte-box col-span-5 px-2.5 py-1.5 font-medium text-slate-900 truncate">
                  ${escapeHtml(state.examType)}
                </div>
                <div class="criarte-box col-span-4 px-2.5 py-1.5 text-slate-900">
                  <span class="font-medium">Data:</span> ${escapeHtml(formatDateCriarte(state.examDate))}
                </div>
                <div class="criarte-box col-span-3 px-2.5 py-1.5 text-center font-medium text-slate-900">
                  ${escapeHtml(state.bimester)}
                </div>
              </div>

              <!-- Linha 2: Disciplina | Professor | Valor -->
              <div class="grid grid-cols-12 gap-1.5 text-[11px]">
                <div class="criarte-box col-span-5 px-2.5 py-1.5 text-slate-900 truncate">
                  <span class="font-medium">Disciplina:</span> ${escapeHtml(state.subject || '—')}
                </div>
                <div class="criarte-box col-span-5 px-2.5 py-1.5 text-slate-900 truncate">
                  <span class="font-medium">Professor:</span> ${escapeHtml(state.teacher || '—')}
                </div>
                <div class="criarte-box col-span-2 px-2 py-1.5 text-center text-slate-900 whitespace-nowrap">
                  Valor: ${formatPoints(state.targetScore)}
                </div>
              </div>

              <!-- Linhas 3 e 4 com caixa Nota ocupando duas linhas à direita -->
              <div class="grid grid-cols-12 gap-1.5 text-[11px]">
                <div class="col-span-10 space-y-1.5">
                  <!-- Linha 3: Série | Turma (bolinhas) | RM -->
                  <div class="grid grid-cols-12 gap-1.5">
                    <div class="criarte-box col-span-4 px-2.5 py-1.5 text-slate-900 font-medium truncate">
                      ${escapeHtml(state.grade)}
                    </div>
                    <div class="criarte-box col-span-5 px-2.5 py-1.5 text-slate-900 flex items-center flex-wrap">
                      <span class="mr-1.5">Turma:</span>
                      ${renderTurmaCircles(state.classGroup)}
                    </div>
                    <div class="criarte-box col-span-3 px-2.5 py-1.5 text-slate-900">
                      RM:
                    </div>
                  </div>
                  <!-- Linha 4: Nome | Nº -->
                  <div class="grid grid-cols-12 gap-1.5">
                    <div class="criarte-box col-span-10 px-2.5 py-1.5 text-slate-900">
                      Nome:
                    </div>
                    <div class="criarte-box col-span-2 px-2 py-1.5 text-slate-900">
                      Nº
                    </div>
                  </div>
                </div>

                <!-- Caixa Nota (2 linhas de altura) -->
                <div class="criarte-box col-span-2 px-2 py-1.5 text-slate-900 flex flex-col justify-between">
                  <span class="font-medium">Nota:</span>
                  <span class="text-[9px] text-slate-400 text-right">/ ${formatPoints(state.targetScore)}</span>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- QUADRO CONTEÚDO -->
        ${contentBoxHtml}

        <!-- QUADRO INSTRUÇÕES OFICIAIS -->
        ${instructionsHtml}

        <!-- CADERNO DE QUESTÕES -->
        ${questionsSectionHeader}
          ${questionsHtml}
          ${rubricHtml}
        </div>
      `;
    }

    /* ---------- AÇÕES E EVENTOS ---------- */

    function switchTab(tabName) {
      state.activeTab = tabName;
      document.querySelectorAll('.tab-panel').forEach(p => p.classList.add('hidden'));
      const activePanel = document.getElementById(`panel-${tabName}`);
      if (activePanel) activePanel.classList.remove('hidden');

      document.querySelectorAll('.tab-btn').forEach(btn => {
        const isCurrent = btn.dataset.tab === tabName;
        const badge = btn.querySelector('span');
        if (isCurrent) {
          btn.classList.add('bg-blue-50', 'text-[#0b2a82]');
          btn.classList.remove('text-slate-600', 'hover:bg-slate-50');
          badge.classList.add('bg-[#0b2a82]', 'text-white');
          badge.classList.remove('bg-slate-200', 'text-slate-700');
        } else {
          btn.classList.remove('bg-blue-50', 'text-[#0b2a82]');
          btn.classList.add('text-slate-600', 'hover:bg-slate-50');
          badge.classList.remove('bg-[#0b2a82]', 'text-white');
          badge.classList.add('bg-slate-200', 'text-slate-700');
        }
      });
    }

    function setViewMode(mode) {
      state.viewMode = mode;
      const btnStudent = document.getElementById('btnModeStudent');
      const btnKey = document.getElementById('btnModeKey');
      const label = document.getElementById('previewModeLabel');

      if (mode === 'student') {
        btnStudent.className = 'px-2.5 py-1 text-xs font-semibold rounded-md transition-colors bg-white text-[#0b2a82] shadow-sm';
        btnKey.className = 'px-2.5 py-1 text-xs font-semibold rounded-md transition-colors text-slate-600 hover:text-slate-900';
        label.className = 'text-[11px] font-semibold px-2 py-0.5 rounded bg-blue-100 text-[#0b2a82]';
        label.textContent = 'Versão do Aluno';
      } else {
        btnKey.className = 'px-2.5 py-1 text-xs font-semibold rounded-md transition-colors bg-emerald-600 text-white shadow-sm';
        btnStudent.className = 'px-2.5 py-1 text-xs font-semibold rounded-md transition-colors text-slate-600 hover:text-slate-900';
        label.className = 'text-[11px] font-semibold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800';
        label.textContent = 'Gabarito do Professor';
      }
      renderPreview();
    }

    function addQuestion() {
      const currentSum = state.questions.reduce((acc, q) => acc + (Number(q.points) || 0), 0);
      const remaining = Math.max(0.5, Number(((Number(state.targetScore) || 10) - currentSum).toFixed(1)));
      const suggestedPoints = currentSum < (Number(state.targetScore) || 10) ? Math.min(remaining, 2.5) : 2.0;

      state.questions.push({
        id: 'q_' + Date.now(),
        context: '',
        prompt: '',
        points: suggestedPoints,
        lines: 5,
        expectedAnswer: ''
      });
      saveState();
      renderQuestionsEditor();
      updateScoreBadge();
      renderPreview();
      showToast('Nova questão adicionada');
    }

    function initEvents() {
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', () => switchTab(btn.dataset.tab));
      });

      document.getElementById('btnGoToQuestions').addEventListener('click', () => switchTab('questions'));
      document.getElementById('btnAddQuestion').addEventListener('click', addQuestion);

      document.getElementById('btnModeStudent').addEventListener('click', () => setViewMode('student'));
      document.getElementById('btnModeKey').addEventListener('click', () => setViewMode('key'));

      document.getElementById('btnPrint').addEventListener('click', () => {
        window.print();
      });

      document.getElementById('customSubjectInput').addEventListener('input', e => {
        const val = e.target.value.trim();
        if (val) {
          state.subject = val;
          saveState();
          renderSubjectChips();
          renderPreview();
        }
      });

      document.getElementById('gradeSelect').addEventListener('change', e => {
        state.grade = e.target.value;
        saveState();
        renderPreview();
        flashHeaderPreview();
      });

      document.getElementById('classGroupInput').addEventListener('input', e => {
        state.classGroup = e.target.value;
        saveState();
        renderPreview();
      });

      document.getElementById('examTypeSelect').addEventListener('change', e => {
        state.examType = e.target.value;
        saveState();
        renderPreview();
        flashHeaderPreview();
      });

      document.getElementById('examDateInput').addEventListener('change', e => {
        state.examDate = e.target.value;
        saveState();
        renderPreview();
      });

      document.getElementById('teacherInput').addEventListener('input', e => {
        state.teacher = e.target.value;
        saveState();
        renderPreview();
      });

      document.getElementById('targetScoreInput').addEventListener('input', e => {
        state.targetScore = parseFloat(e.target.value) || 10;
        saveState();
        updateScoreBadge();
        renderPreview();
      });

      document.getElementById('topicsTextarea').addEventListener('input', e => {
        state.topicsText = e.target.value;
        saveState();
        renderPreview();
      });

      document.getElementById('schoolNameInput').addEventListener('input', e => {
        state.schoolName = e.target.value;
        saveState();
        renderPreview();
      });

      document.getElementById('schoolSubtitleInput').addEventListener('input', e => {
        state.schoolSubtitle = e.target.value;
        saveState();
        renderPreview();
      });

      document.getElementById('toggleInstructions').addEventListener('change', e => {
        state.showInstructions = e.target.checked;
        saveState();
        renderPreview();
      });

      document.getElementById('togglePageBreak').addEventListener('change', e => {
        state.separateCoverPage = e.target.checked;
        saveState();
        renderPreview();
      });

      document.getElementById('toggleRubric').addEventListener('change', e => {
        state.showRubric = e.target.checked;
        saveState();
        renderPreview();
      });

      document.getElementById('logoUploadInput').addEventListener('change', e => {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = ev => {
          state.logoDataUrl = ev.target.result;
          saveState();
          renderHeaderControls();
          renderPreview();
          showToast('Logotipo atualizado');
        };
        reader.readAsDataURL(file);
      });

      document.getElementById('btnRemoveLogo').addEventListener('click', () => {
        state.logoDataUrl = '';
        document.getElementById('logoUploadInput').value = '';
        saveState();
        renderHeaderControls();
        renderPreview();
        showToast('Logotipo padrão Criarte restaurado');
      });

      document.getElementById('btnResetDemo').addEventListener('click', () => {
        state = getDefaultState();
        saveState();
        renderHeaderControls();
        renderQuestionsEditor();
        updateScoreBadge();
        setViewMode('student');
        switchTab('header');
        showToast('Padrão Colégio Criarte restaurado');
      });
    }

    // Inicialização
    initEvents();
    renderHeaderControls();
    renderQuestionsEditor();
    updateScoreBadge();
    setViewMode(state.viewMode);
    switchTab(state.activeTab);
    lucide.createIcons();
  </script>
</body>
</html>
