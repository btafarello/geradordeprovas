            const verb = chip.dataset.verb;
            const ta = card.querySelector('.q-prompt');
            const current = ta.value.trim();
            q.prompt = current ? `${verb} ${current.charAt(0).toLowerCase() + current.slice(1)}` : `${verb} `;
