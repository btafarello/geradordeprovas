          state.segment = newSeg;
          const segInfo = SEGMENT_DATA[newSeg];
          if (!segInfo.grades.includes(state.grade)) {
            state.grade = segInfo.grades[0];
          }
          if (!segInfo.subjects.includes(state.subject)) {
            state.subject = segInfo.subjects[0];
          }
          saveState();
          renderHeaderControls();
          renderPreview();
          flashHeaderPreview();
        });
      });
    }

